NEXT_PUBLIC_API_URL="http://localhost:3000"

# The app's own origin, used by robots.ts and sitemap.ts to build absolute
# URLs. Deployments do not need to set this — it only matters for SEO
# metadata, and defaults to the local dev origin.
NEXT_PUBLIC_APP_URL="http://localhost:3001"

NEXT_PUBLIC_SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"
NEXT_PUBLIC_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Must match the backend's ADMIN_ADDRESS. Used only to decide whether the
# "Platform Admin" nav link is shown — the backend enforces access on every
# admin request regardless of this value.
NEXT_PUBLIC_ADMIN_ADDRESS=""

# The live testnet deployment (see streamgive-contracts/deployments.json).
# These are public contract ids, not secrets — copy this file to .env.local
# and the app talks to the real deployed contracts with no further setup.
NEXT_PUBLIC_DONATION_VAULT_CONTRACT_ID="CDLKBGX3VTFZZBVBNQYHF47PQO6I7UTBYVVQE3BPJDONF6G4U33Z7VLH"
NEXT_PUBLIC_NGO_REGISTRY_CONTRACT_ID="CCPWQBI7FV2CZ7EECOVZ5XHOHK5S7CS6XTBDWPWHBEOKPTIASNGOBQFH"

# Circle's USDC issuer. Defaults to testnet; set mainnet's issuer to move
# networks. The token contract address is derived from this, so there is
# nothing else to change.
NEXT_PUBLIC_USDC_ISSUER="GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5"
